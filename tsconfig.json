{
	"compilerOptions": {
		"target": "es2022",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"module": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"lib": [],
		"typeRoots": ["./types"],
		"types": ["min-types"]
	},
	"include": ["./src/**/*.ts"]
}
